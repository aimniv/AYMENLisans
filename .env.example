# Sunucu portu
PORT=3000

# SQLite veritabanı dosyası (varsayılan: ./data/aymenlisans.db)
DATABASE_PATH="./data/aymenlisans.db"

# Yönetici hesabı. ADMIN_PASSWORD (en az 8 karakter) tanımlıysa her açılışta bu şifreye eşitlenir.
# Tanımlı değilse ve hesap yoksa rastgele şifre üretilip konsola bir kez yazılır.
ADMIN_EMAIL="admin@aymenlisans.com"
ADMIN_PASSWORD=""

# Ters proxy (nginx, Cloudflare vb.) arkasındaysanız "true" yapın (doğru istemci IP'si için)
TRUST_PROXY=""

# İsteğe bağlı harici ödeme sağlayıcısı yönlendirme URL'si (iyzico, PayTR vb.)
PAYMENT_PROVIDER_CHECKOUT_URL=""
